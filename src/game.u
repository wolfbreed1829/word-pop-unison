-- Word Pop! All game logic, page rendering, and HTTP handling run in Unison.
use Text ++
use lib.unison_cloud_27_3_1.lib.unison_http_15_0_0 HttpRequest HttpResponse Body

structural type Card = Card Text Text Text Text Text

pop.deck : [Card]
pop.deck =
  [ Card "smart" "ar" "Quick at learning and solving problems." "You had a smart idea for the science project." "Think of a word that means clever."
  , Card "award" "ar" "A prize given for doing something well." "She won an award for her beautiful painting." "A trophy is one kind of this prize."
  , Card "charge" "ar" "To fill a battery with power." "Please charge the tablet before our trip." "What do you do when a battery is empty?"
  , Card "worn" "or" "Used so much that it looks old." "My favorite shoes are worn from all our walks." "These old shoes have been used a lot."
  , Card "argue" "ar" "To disagree using words." "We can share our ideas without starting to argue." "To disagree out loud."
  , Card "stormy" "or" "Having strong wind, rain, or thunder." "The stormy weather kept us inside." "How would you describe a day with thunder?"
  , Card "bore" "ore" "To make someone feel uninterested." "The long wait might bore the children." "The opposite of keeping someone interested."
  , Card "ward" "ar" "A section of a hospital." "The nurse works in the children's ward." "A hospital section where patients stay."
  , Card "warp" "ar" "To bend or twist out of shape." "Too much water can warp the wooden door." "Wood can do this when it gets too wet."
  , Card "backyard" "ar" "The outdoor space behind a house." "We planted sunflowers in our backyard." "A compound word: back + yard."
  , Card "door" "oor" "A movable panel that opens an entrance." "Please close the door to keep the room warm." "You open this to enter a room."
  , Card "dart" "ar" "To move suddenly and quickly." "We watched the rabbit dart across the grass." "A quick, sudden movement."
  , Card "fort" "or" "A strong building or shelter for protection." "We built a blanket fort in the living room." "You might build this with pillows and blankets."
  , Card "morning" "or" "The early part of the day." "We eat breakfast every morning." "The time of day before noon."
  , Card "carpet" "ar" "A thick, soft covering for a floor." "The soft carpet felt warm under my feet." "A soft floor covering, often made of wool."
  , Card "core" "ore" "The center or most important part." "The seeds are inside the core of the apple." "The center of an apple."
  , Card "spark" "ar" "A tiny, glowing piece from a fire." "One bright spark floated above the campfire." "A tiny flash that can start a fire."
  , Card "charcoal" "ar" "A black material used as fuel or for drawing." "The artist used charcoal to draw the trees." "A black drawing material made from heated wood."
  , Card "forecast" "ore" "A prediction of what will happen." "The weather forecast says it will rain tomorrow." "A weather report predicts this."
  , Card "guard" "uar" "To watch over and protect." "Our dog likes to guard the front gate." "To protect or keep watch over something."
  ]

pop.word : Card -> Text
pop.word = cases Card word _ _ _ _ -> word
pop.focus : Card -> Text
pop.focus = cases Card _ focus _ _ _ -> focus
pop.meaning : Card -> Text
pop.meaning = cases Card _ _ meaning _ _ -> meaning
pop.sentence : Card -> Text
pop.sentence = cases Card _ _ _ sentence _ -> sentence
pop.hint : Card -> Text
pop.hint = cases Card _ _ _ _ hint -> hint

pop.escape : Text -> Text
pop.escape value = value |> Text.replaceAll "&" "&amp;" |> Text.replaceAll "<" "&lt;" |> Text.replaceAll ">" "&gt;" |> Text.replaceAll "\"" "&quot;" |> Text.replaceAll "'" "&#39;"

pop.number : Nat -> Text
pop.number = Nat.toText

pop.normalize : Text -> Text
pop.normalize text = Text.toLowercase (Text.trim text)

pop.correct : Card -> Text -> Boolean
pop.correct card answer = pop.normalize answer == pop.word card

pop.points : Nat -> Nat
pop.points tries = if tries == 0 then 10 else 5

pop.card : Nat -> Card
pop.card n = List.at (Nat.mod n 20) pop.deck |> Optional.getOrElse (Card "smart" "ar" "Quick at learning." "That was a smart idea." "Clever.")

pop.has : Text -> [Text] -> Boolean
pop.has value values = List.any (x -> x == value) values

pop.add : Text -> [Text] -> [Text]
pop.add value values = if pop.has value values then values else (List.++) values [value]

-- Round state is carried by ordinary links and forms. It is a personal practice
-- game, not a trusted leaderboard. Refreshing a result cannot award extra points.
structural type Round = Round Text Nat [Text] [Text] Nat Nat Nat Nat
-- mode, current index, mastered indexes, practice indexes, points, streak, tries, step

pop.url : Round -> Text
pop.url = cases Round mode n known practice points streak tries step ->
  "?m=" ++ mode ++ "&n=" ++ pop.number n ++ "&k=" ++ Text.join "," known ++ "&p=" ++ Text.join "," practice ++ "&s=" ++ pop.number points ++ "&r=" ++ pop.number streak ++ "&t=" ++ pop.number tries ++ "&step=" ++ pop.number step

pop.link : Text -> Text -> Text -> Text
pop.link classes url label = "<a class='" ++ classes ++ "' href='" ++ pop.escape url ++ "'>" ++ label ++ "</a>"

pop.hidden : Text -> Text -> Text
pop.hidden name value = "<input type='hidden' name='" ++ name ++ "' value='" ++ pop.escape value ++ "'>"

pop.fields : Round -> Text
pop.fields = cases Round mode n known practice points streak tries step ->
  Text.join "" [pop.hidden "m" mode, pop.hidden "n" (pop.number n), pop.hidden "k" (Text.join "," known), pop.hidden "p" (Text.join "," practice), pop.hidden "s" (pop.number points), pop.hidden "r" (pop.number streak), pop.hidden "t" (pop.number tries), pop.hidden "step" (pop.number step)]

pop.mascot : Text
pop.mascot = """
  <svg class="mascot" viewBox="0 0 100 110" aria-hidden="true"><path d="M50 6 Q55 5 60 28 L85 29 Q98 30 88 43 L72 62 L78 88 Q81 101 68 96 L49 84 L28 96 Q15 102 20 87 L25 63 L7 44 Q-1 33 14 31 L38 28 Z" fill="#ffce48" stroke="#eab83b" stroke-width="2"/><ellipse cx="37" cy="52" rx="4" ry="6" fill="#48374c"/><ellipse cx="61" cy="52" rx="4" ry="6" fill="#48374c"/><circle cx="28" cy="61" r="5" fill="#f8a065"/><circle cx="71" cy="61" r="5" fill="#f8a065"/><path d="M40 65 Q49 74 58 65" fill="none" stroke="#48374c" stroke-width="3" stroke-linecap="round"/><path d="M6 69 L1 77 M88 12 L94 5" stroke="#57b79a" stroke-width="3" stroke-linecap="round"/></svg>
  """

pop.header : Text
pop.header = """
  <a class="skip" href="#play">Skip to game</a><input class="pause-input" id="pause" type="checkbox"><div class="page">
  <header class="topbar"><div class="wrap"><a class="brand" href="?" aria-label="Word Pop home"><span class="brand-icon" aria-hidden="true">W</span><span>word<em>pop!</em></span></a><nav class="toplinks" aria-label="Main navigation"><a href="?view=help">How to play <span aria-hidden="true">↗</span></a><span class="small-pill">✦ Little words. Big wins.</span></nav></div></header>
  """

pop.hero : Text
pop.hero = """
  <section class="hero"><div><div class="eyebrow"><span class="dot"></span> THE SPELLING PLAYGROUND</div><h1>Small words.<br>Big <em>brain energy.</em></h1><p>A little practice. A lot of possibilities. Let's make words stick!</p></div><div class="hero-doodle" aria-hidden="true"><span class="tile">a</span><span class="tile">b</span><span class="tile">c</span><span class="doodle-spark">✦</span><span class="doodle-spark bottom">✳</span></div></section>
  """

pop.tabs : Round -> Text
pop.tabs = cases Round mode n known practice points streak tries step ->
  tab target icon label = pop.link ("mode" ++ (if mode == target then " active" else "")) (pop.url (Round target n known practice points 0 0 0)) ("<span aria-hidden='true'>" ++ icon ++ "</span>" ++ label)
  "<nav class='mode-tabs' aria-label='Game modes'>" ++ tab "flash" "▣" "Flashcards" ++ tab "spell" "✎" "Spell it" ++ tab "mix" "⇄" "Word scramble" ++ "</nav>"

pop.audio : Nat -> Text
pop.audio n = "<div class='audio-row'><span>↗ HEAR THE WORD</span><audio controls preload='none' aria-label='Listen to the word' src='?audio=" ++ pop.number n ++ "'>Your browser cannot play audio. Use the clue to practice.</audio></div>"

pop.flash : Round -> Text
pop.flash round = match round with Round _ n _ _ _ _ _ _ ->
  card = pop.card n
  word = pop.word card
  marked = Text.replaceAll (pop.focus card) ("<mark>" ++ pop.focus card ++ "</mark>") word
  sentence = Text.replaceAll word ("<strong>" ++ word ++ "</strong>") (pop.sentence card)
  "<div class='flash'><input class='flip-check' id='flip' type='checkbox' aria-label='Flip the flashcard'><div class='flash-inner'><div class='face front'><span class='face-label'>LOOK. SAY. REMEMBER.</span><span class='face-star' aria-hidden='true'>✦</span><div class='word" ++ (if Text.size word > 7 then " long" else "") ++ "'>" ++ marked ++ "</div><div class='syllable'>" ++ pop.number (Text.size word) ++ " letters · one new superpower</div></div><div class='face back'><span class='face-label'>LET'S MAKE IT STICK</span><span class='face-star' aria-hidden='true'>✦</span><p class='meaning'>" ++ pop.meaning card ++ "</p><p class='example'>“" ++ sentence ++ "”</p></div></div><label class='flip-label' for='flip'><span aria-hidden='true'>⤾</span> Tap to flip the card</label></div>" ++ pop.audio n ++ "<div class='actions'>" ++ pop.link "btn yellow" (pop.url round ++ "&action=practice") "↻ Practice again" ++ pop.link "btn green" (pop.url round ++ "&action=known") "✓ Got it!" ++ "</div>"

pop.scramble : Text -> Text
pop.scramble word =
  letters = Text.toCharList word |> List.reverse
  "<div class='scramble' aria-label='Scrambled letters'>" ++ Text.join "" (List.map (letter -> "<b>" ++ Text.fromCharList [letter] ++ "</b>") letters) ++ "</div>"

pop.question : Round -> Text -> Text
pop.question round feedback = match round with Round mode n _ _ _ _ _ _ ->
  card = pop.card n
  prompt = if mode == "mix" then pop.scramble (pop.word card) else "<div class='result-icon' aria-hidden='true'>✎</div>"
  title = if mode == "mix" then "Put the letters in their place." else "Listen. Think. Spell!"
  "<div class='question'>" ++ feedback ++ prompt ++ "<h2>" ++ title ++ "</h2><p>" ++ pop.meaning card ++ "</p>" ++ pop.audio n ++ "<form method='get' action=''>" ++ pop.fields round ++ "<label for='answer'>Your spelling</label><div class='answer-row'><input id='answer' name='answer' type='text' placeholder='Type the word…' autocomplete='off' autocapitalize='none' spellcheck='false' required maxlength='32' aria-describedby='answer-help' autofocus><button class='btn purple' type='submit'>Check it ↗</button></div><p id='answer-help'>" ++ pop.number (Text.size (pop.word card)) ++ " letters. You've got this!</p></form><details class='hint'><summary>☀ Need a little hint?</summary><p>" ++ pop.hint card ++ "<br>It starts with <strong>" ++ Text.take 1 (pop.word card) ++ "</strong>.</p></details></div>"

pop.confetti : Text
pop.confetti = "<div class='confetti' aria-hidden='true'>" ++ Text.join "" (List.map (n -> "<i style='--x:" ++ pop.number (Nat.mod (n * 17) 100) ++ "%;--d:0." ++ pop.number (Nat.mod n 9) ++ "s;--c:" ++ (if Nat.mod n 3 == 0 then "#ffcf4b" else if Nat.mod n 3 == 1 then "#f65d92" else "#77d9bb") ++ "'></i>") (List.range 0 25)) ++ "</div>"

pop.progress : Round -> Text
pop.progress = cases Round _ _ known _ points streak _ _ ->
  "<section class='stats-card' aria-labelledby='progress-title'><div class='panel-heading'><h2 id='progress-title'>Your happy progress</h2><span aria-hidden='true'>✦</span></div><div class='progress-top'><span>Words mastered</span><b>" ++ pop.number (List.size known) ++ " / 20</b></div><div class='progress-bar' role='progressbar' aria-label='Words mastered' aria-valuemin='0' aria-valuemax='20' aria-valuenow='" ++ pop.number (List.size known) ++ "'><div style='width:" ++ pop.number (List.size known * 5) ++ "%'></div></div><div class='stat-row'><div class='stat-box'><b>★ " ++ pop.number points ++ "</b><span>HAPPY POINTS</span></div><div class='stat-box pink'><b>♨ " ++ pop.number streak ++ "</b><span>IN A ROW</span></div></div></section>"

pop.bank : Round -> Text
pop.bank = cases Round mode n known practice points _ _ step ->
  chip i =
    card = pop.card i
    mastered = pop.has (pop.number i) known
    classes = "word-chip" ++ (if i == n then " selected" else "") ++ (if mastered then " done" else "")
    label = if mode == "flash" then pop.word card else (if mastered then "✓ " else "") ++ pop.number (i + 1)
    pop.link classes (pop.url (Round mode i known practice points 0 0 step)) label
  "<section class='word-bank'><div class='panel-heading'><h2>Your word collection</h2><span>20 words</span></div><div class='word-grid'>" ++ Text.join "" (List.map chip (List.range 0 20)) ++ "</div><p class='bank-foot'><i></i> Green means you've got it!</p></section>"

pop.sidebar : Round -> Text
pop.sidebar round = pop.progress round ++ "<div class='mascot-card'>" ++ pop.mascot ++ "<div><strong>A little better<br>with every letter.</strong><p>Mistakes are just your brain growing. Keep going!</p></div></div>" ++ pop.bank round

pop.footer : Text
pop.footer = """
  <footer><span class="mini-brand">MADE FOR CURIOUS MINDS ✦</span><span>20 words · Endless possibility</span><label class="pause-label" for="pause">Pause motion</label><a href="https://github.com/wolfbreed1829/word-pop-unison" target="_blank" rel="noopener">Made with Unison ↗</a></footer>
  """

pop.shell : Text -> Text -> Text
pop.shell css body = "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='theme-color' content='#7350e6'><meta name='description' content='A colorful spelling playground. Flip flashcards, hear words, solve scrambles, and celebrate every little win.'><title>Word Pop! — A little practice. A lot of possibility.</title><link rel='icon' href='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 rx=%2218%22 fill=%22%237350e6%22/%3E%3Ctext x=%2210%22 y=%2248%22 font-size=%2246%22 font-family=%22Arial%22 font-weight=%22bold%22 fill=%22white%22%3EW%3C/text%3E%3C/svg%3E'><style>" ++ css ++ "</style></head><body>" ++ pop.header ++ body ++ "</div></body></html>"

pop.help : Text
pop.help = """
  <main class="help" id="play"><div class="eyebrow">LET'S PLAY WITH WORDS</div><h1>Little steps. Big wins.</h1><section><h2>▣ Flip a flashcard</h2><p>Read the word out loud, play its recording, and tap the flip button to see what it means. Choose <strong>Got it!</strong> to mark it mastered, or <strong>Practice again</strong> to put it on your practice list.</p></section><section><h2>✎ Give spelling a go</h2><p>Choose <strong>Spell it</strong>, play the word, and type what you hear. A correct first try earns 10 happy points. A correct answer after another try earns 5. A mistake resets your streak, but you can always try again. Each word earns points once per round.</p></section><section><h2>⇄ Untangle a word</h2><p>Choose <strong>Word scramble</strong> and use all the colorful letters to figure out the word. The meaning, recording, and hint can help. Your progress travels with the game links in this tab. Start a fresh round from the home logo; no account is needed.</p></section><section><h2>☀ Make yourself comfortable</h2><p>Everything works with a keyboard: Tab to a control, then Enter or Space. Use your browser zoom for bigger letters. The site follows your reduced-motion setting, and the footer has a pause-motion toggle. Audio only plays when you press play.</p></section><a class="btn purple" href="?">Let's play ↗</a></main>
  """

pop.next : Round -> Round
pop.next = cases Round mode n known practice points streak _ step ->
  Round mode (Nat.mod (n + 1) 20) known practice points streak 0 (step + 1)

pop.withIndex : Nat -> Round -> Round
pop.withIndex i = cases Round mode _ known practice points streak _ step -> Round mode i known practice points streak 0 step

pop.practiceAgain : Round -> Round
pop.practiceAgain = cases Round mode n known practice points _ _ step ->
  Round mode n known (pop.add (pop.number n) practice) points 0 1 step

pop.master : Boolean -> Round -> Round
pop.master scored = cases Round mode n known practice points streak tries step ->
  key = pop.number n
  fresh = not (pop.has key known)
  earned = if fresh then (if scored then pop.points tries else 5) else 0
  Round mode n (pop.add key known) (List.filter (x -> not (x == key)) practice) (points + earned) (if scored && fresh then streak + 1 else streak) tries step

pop.bottom : Round -> Text
pop.bottom round = match round with Round _ n known _ _ _ _ _ ->
  dots = Text.join "" (List.map (i -> "<i class='" ++ (if i == n then "current" else if pop.has (pop.number i) known then "done" else "") ++ "'></i>") (List.range 0 20))
  "<div class='card-foot'><span>One word at a time. ✨</span><div class='progress-dots' aria-hidden='true'>" ++ dots ++ "</div><div class='round-nav'>" ++ pop.link "circle-btn" (pop.url (pop.withIndex (Nat.mod (n + 19) 20) round)) "<span aria-label='Previous word'>←</span>" ++ pop.link "circle-btn" (pop.url (pop.withIndex (Nat.mod (n + 1) 20) round)) "<span aria-label='Next word'>→</span>" ++ "</div></div>"

pop.finished : Round -> Text
pop.finished = cases Round mode _ known practice points _ _ _ ->
  restart = Round mode 0 [] [] 0 0 0 0
  practiceIndex = List.head practice |> Optional.flatMap Nat.fromText |> Optional.getOrElse 0
  practiceLink = if List.size practice > 0 then pop.link "btn yellow" (pop.url (Round mode practiceIndex known practice points 0 0 0)) "Revisit a tricky word ↗" else ""
  "<div class='finished'>" ++ pop.confetti ++ pop.mascot ++ "<h2>Look at you grow!</h2><p>You made it through your round.<br>Every word you practiced is a little win.</p><div class='score-big'>" ++ pop.number points ++ "<span style='font-size:25px'> ★</span></div><p>" ++ pop.number (List.size known) ++ " words mastered · " ++ pop.number (List.size practice) ++ " to practice</p><div class='actions'>" ++ practiceLink ++ pop.link "btn purple" (pop.url restart) "Play a fresh round ↗" ++ "</div></div>"

pop.content : Round -> Text -> Text -> Text
pop.content round answer action = match round with Round mode n known practice points streak tries step ->
  if step >= 20 then pop.finished round
  else if mode == "flash" then pop.flash round
  else if answer == "" then pop.question round ""
  else if pop.correct (pop.card n) answer then
    earned = if pop.has (pop.number n) known then 0 else pop.points tries
    mastered = pop.master true round
    "<div class='question'>" ++ pop.confetti ++ "<div class='result-icon' aria-hidden='true'>🌟</div><div class='feedback'><h2>That's the word!</h2><p>+" ++ pop.number earned ++ " happy points. Keep that brain growing!</p></div><div class='success-word'>" ++ pop.word (pop.card n) ++ "</div><p>" ++ pop.sentence (pop.card n) ++ "</p>" ++ pop.link "btn purple" (pop.url (pop.next mastered)) (if step == 19 then "See my round ↗" else "Next word →") ++ "</div>"
  else pop.question (pop.practiceAgain round) "<div class='feedback retry' role='status'><h2>Almost! Give it another go.</h2><p>Listen again and take your time. Mistakes help us learn.</p></div>"

pop.page : Text -> Round -> Text -> Text -> Text
pop.page css initial answer action =
  afterAction = if action == "known" then pop.next (pop.master false initial) else if action == "practice" then pop.next (pop.practiceAgain initial) else initial
  match afterAction with Round mode n _ _ _ _ _ step ->
    displayRound = if answer == "" || mode == "flash" then afterAction else if pop.correct (pop.card n) answer then pop.master true afterAction else pop.practiceAgain afterAction
    stageTitle = if mode == "flash" then "A LITTLE FLIP. A LITTLE LEARNING." else if mode == "spell" then "READY, SET, SPELL!" else "A LITTLE LETTER MAGIC."
    tip = if mode == "flash" then "Say it. Cover it. Spell it!" else if mode == "spell" then "Listen for the little sounds." else "Look for letters that like to stick together."
    tipBody = if mode == "flash" then "Say the word out loud, flip the card, then try spelling it from memory." else if mode == "spell" then "Play the word again. Break it into sounds. Put those sounds back together." else "Try finding ar, or, and ore. These letter teams can help you find the word."
    shuffle = pop.withIndex (Nat.mod (n + 7) 20) afterAction
    body = "<main class='wrap' id='play'>" ++ pop.hero ++ "<div class='layout'><section class='play-area' aria-label='Spelling game'>" ++ pop.tabs displayRound ++ "<div class='card-stage'><div class='stage-top'><span>" ++ stageTitle ++ "</span><b>" ++ pop.number (Nat.min 20 (step + 1)) ++ " / 20</b></div>" ++ pop.content afterAction answer action ++ "</div>" ++ pop.bottom displayRound ++ "<div class='tip'><div class='tip-icon' aria-hidden='true'>☀</div><div><strong>" ++ tip ++ "</strong><p>" ++ tipBody ++ "</p></div></div><div class='motivation'>" ++ pop.link "shuffle" (pop.url shuffle) "⇄ Surprise me with another word" ++ "</div></section><aside class='sidebar' aria-label='Your progress and words'>" ++ pop.sidebar displayRound ++ "</aside></div>" ++ pop.footer ++ "</main>"
    pop.shell css body

pop.param : Text -> HttpRequest -> Text
pop.param key request =
  query =
    lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpRequest.uri request
      |> lib.unison_base_7_20_0.IO.net.URI.query
      |> lib.unison_base_7_20_0.IO.net.URI.Query.fromRawQuery
      |> Optional.getOrElse lib.unison_base_7_20_0.IO.net.URI.Query.empty
  lib.unison_base_7_20_0.IO.net.URI.Query.getParam key query |> List.head |> Optional.getOrElse ""

pop.natParam : Text -> HttpRequest -> Nat
pop.natParam key request = pop.param key request |> Nat.fromText |> Optional.getOrElse 0

pop.indexes : Text -> [Text]
pop.indexes value =
  values = Text.splitOnText "," (Text.take 100 value)
  List.filter (x -> pop.has x values) (List.map pop.number (List.range 0 20))

pop.round : HttpRequest -> Round
pop.round request =
  mode = pop.param "m" request
  Round (if mode == "spell" || mode == "mix" then mode else "flash")
    (Nat.mod (pop.natParam "n" request) 20)
    (pop.indexes (pop.param "k" request))
    (pop.indexes (pop.param "p" request))
    (Nat.min 200 (pop.natParam "s" request))
    (Nat.min 20 (pop.natParam "r" request))
    (Nat.min 1 (pop.natParam "t" request))
    (Nat.min 20 (pop.natParam "step" request))

pop.response : Text -> Bytes -> HttpResponse
pop.response kind bytes =
  lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.ok (lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.Body.Body bytes)
    |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Content-Type" kind
    |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "X-Content-Type-Options" "nosniff"

pop.service : Text -> [Bytes] -> HttpRequest -> HttpResponse
pop.service css clips request =
  if pop.param "audio" request == "" then
    page = if pop.param "view" request == "help" then pop.shell css pop.help else pop.page css (pop.round request) (Text.take 32 (pop.param "answer" request)) (pop.param "action" request)
    pop.response "text/html; charset=utf-8" (Text.toUtf8 page)
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Cache-Control" "no-store"
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Content-Security-Policy" "default-src 'none'; script-src 'none'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; media-src 'self'; img-src data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Referrer-Policy" "no-referrer"
  else match List.at (pop.natParam "audio" request) clips with
    Some clip -> pop.response "audio/wav" clip |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Cache-Control" "public, max-age=86400"
    None -> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.notFound

pop.assets : '{IO, Exception} (Text, [Bytes])
pop.assets = do
  css = lib.unison_base_7_20_0.IO.FilePath.readFileUtf8 (FilePath "assets/style.css")
  clips = List.map (n -> lib.unison_base_7_20_0.IO.FilePath.readFile (FilePath ("assets/audio/" ++ pop.number n ++ ".wav"))) (List.range 0 20)
  (css, clips)

pop.local : '{IO, Exception} ()
pop.local = do
  (css, clips) = pop.assets()
  config =
    lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.server.Config.default
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.server.Config.port.set (Port "8089")
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.server.Config.hostName.set (Some (HostName "127.0.0.1"))
  printLine "Word Pop! http://127.0.0.1:8089"
  Threads.run do
    lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.server.runServer config (request -> Left (pop.service css clips request))

pop.deploy : '{IO, Exception} ()
pop.deploy = do
  (css, clips) = pop.assets()
  url = lib.unison_cloud_27_3_1.Cloud.main do
    hash = lib.unison_cloud_27_3_1.Cloud.deployHttp (lib.unison_cloud_27_3_1.Environment.default()) (pop.service css clips)
    lib.unison_cloud_27_3_1.ServiceName.assign (lib.unison_cloud_27_3_1.ServiceName.named "word-pop") hash
  printLine (lib.unison_base_7_20_0.IO.net.URI.toText (url()))

test> pop.tests.deck = check (List.size pop.deck == 20 && pop.word (pop.card 19) == "guard")
test> pop.tests.answers = check (pop.correct (pop.card 0) " SMART " && not (pop.correct (pop.card 0) "smrt") && not (pop.correct (pop.card 0) ""))
test> pop.tests.points = check (pop.points 0 == 10 && pop.points 1 == 5)
test> pop.tests.master =
  initial = Round "spell" 0 [] [] 0 0 0 0
  once = pop.master true initial
  twice = pop.master true once
  check (pop.url once == pop.url twice && pop.url once == "?m=spell&n=0&k=0&p=&s=10&r=1&t=0&step=0")
test> pop.tests.retry = check (pop.url (pop.master true (pop.practiceAgain (Round "spell" 0 [] [] 0 4 0 0))) == "?m=spell&n=0&k=0&p=&s=5&r=1&t=1&step=0")
test> pop.tests.indexes = check (Text.join "," (pop.indexes "3,3,99,<script>,1") == "1,3")
test> pop.tests.escape = check (pop.escape "<script>" == "&lt;script&gt;")
