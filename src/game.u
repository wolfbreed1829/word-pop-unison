-- Word Pop! All game logic, page rendering, and HTTP handling run in Unison.
use Text ++
use lib.unison_cloud_27_3_1.lib.unison_http_15_0_0 HttpRequest HttpResponse Body

structural type Card = Card Text Text Text Text Text

pop.deck : [Card]
pop.deck =
  [ Card "smart" "ar" "Quick at learning and solving problems." "You had a smart idea for the science project." "Think of a word that means clever."
  , Card "award" "ar" "A prize given for doing something well." "She won an award for her beautiful painting." "A trophy is one kind of this prize."
  , Card "charge" "ar" "To fill a battery with power." "Please charge the tablet before our trip." "What do you do when a battery is empty?"
  , Card "worn" "or" "Used so much that it looks old." "My favorite shoes are worn from all our walks." "These old shoes have been used a lot."
  , Card "argue" "ar" "To disagree using words." "We can share our ideas without starting to argue." "To disagree out loud."
  , Card "stormy" "or" "Having strong wind, rain, or thunder." "The stormy weather kept us inside." "How would you describe a day with thunder?"
  , Card "bore" "ore" "To make someone feel uninterested." "The long wait might bore the children." "The opposite of keeping someone interested."
  , Card "ward" "ar" "A section of a hospital." "The nurse works in the children's ward." "A hospital section where patients stay."
  , Card "warp" "ar" "To bend or twist out of shape." "Too much water can warp the wooden door." "Wood can do this when it gets too wet."
  , Card "backyard" "ar" "The outdoor space behind a house." "We planted sunflowers in our backyard." "A compound word: back + yard."
  , Card "door" "oor" "A movable panel that opens an entrance." "Please close the door to keep the room warm." "You open this to enter a room."
  , Card "dart" "ar" "To move suddenly and quickly." "We watched the rabbit dart across the grass." "A quick, sudden movement."
  , Card "fort" "or" "A strong building or shelter for protection." "We built a blanket fort in the living room." "You might build this with pillows and blankets."
  , Card "morning" "or" "The early part of the day." "We eat breakfast every morning." "The time of day before noon."
  , Card "carpet" "ar" "A thick, soft covering for a floor." "The soft carpet felt warm under my feet." "A soft floor covering, often made of wool."
  , Card "core" "ore" "The center or most important part." "The seeds are inside the core of the apple." "The center of an apple."
  , Card "spark" "ar" "A tiny, glowing piece from a fire." "One bright spark floated above the campfire." "A tiny flash that can start a fire."
  , Card "charcoal" "ar" "A black material used as fuel or for drawing." "The artist used charcoal to draw the trees." "A black drawing material made from heated wood."
  , Card "forecast" "ore" "A prediction of what will happen." "The weather forecast says it will rain tomorrow." "A weather report predicts this."
  , Card "guard" "uar" "To watch over and protect." "Our dog likes to guard the front gate." "To protect or keep watch over something."
  ]

pop.word : Card -> Text
pop.word = cases Card word _ _ _ _ -> word
pop.focus : Card -> Text
pop.focus = cases Card _ focus _ _ _ -> focus
pop.meaning : Card -> Text
pop.meaning = cases Card _ _ meaning _ _ -> meaning
pop.sentence : Card -> Text
pop.sentence = cases Card _ _ _ sentence _ -> sentence
pop.hint : Card -> Text
pop.hint = cases Card _ _ _ _ hint -> hint

pop.escape : Text -> Text
pop.escape value = value |> Text.replaceAll "&" "&amp;" |> Text.replaceAll "<" "&lt;" |> Text.replaceAll ">" "&gt;" |> Text.replaceAll "\"" "&quot;" |> Text.replaceAll "'" "&#39;"

pop.number : Nat -> Text
pop.number = Nat.toText

pop.normalize : Text -> Text
pop.normalize text = Text.toLowercase (Text.trim text)

pop.correct : Card -> Text -> Boolean
pop.correct card answer = pop.normalize answer == pop.word card

pop.points : Nat -> Nat
pop.points tries = if tries == 0 then 10 else 5

pop.card : Nat -> Card
pop.card n = List.at (Nat.mod n 20) pop.deck |> Optional.getOrElse (Card "smart" "ar" "Quick at learning." "That was a smart idea." "Clever.")

pop.has : Text -> [Text] -> Boolean
pop.has value values = List.any (x -> x == value) values

pop.add : Text -> [Text] -> [Text]
pop.add value values = if pop.has value values then values else (List.++) values [value]

-- Round state is carried by ordinary links and forms. It is a personal practice
-- game, not a trusted leaderboard. Refreshing a result cannot award extra points.
structural type Round = Round Text Nat [Text] [Text] Nat Nat Nat Nat
-- mode, current index, mastered indexes, practice indexes, points, streak, tries, step

pop.url : Round -> Text
pop.url = cases Round mode n known practice points streak tries step ->
  "?m=" ++ mode ++ "&n=" ++ pop.number n ++ "&k=" ++ Text.join "," known ++ "&p=" ++ Text.join "," practice ++ "&s=" ++ pop.number points ++ "&r=" ++ pop.number streak ++ "&t=" ++ pop.number tries ++ "&step=" ++ pop.number step

pop.link : Text -> Text -> Text -> Text
pop.link classes url label = "<a class='" ++ classes ++ "' href='" ++ pop.escape url ++ "'>" ++ label ++ "</a>"

pop.hidden : Text -> Text -> Text
pop.hidden name value = "<input type='hidden' name='" ++ name ++ "' value='" ++ pop.escape value ++ "'>"

pop.fields : Round -> Text
pop.fields = cases Round mode n known practice points streak tries step ->
  Text.join "" [pop.hidden "m" mode, pop.hidden "n" (pop.number n), pop.hidden "k" (Text.join "," known), pop.hidden "p" (Text.join "," practice), pop.hidden "s" (pop.number points), pop.hidden "r" (pop.number streak), pop.hidden "t" (pop.number tries), pop.hidden "step" (pop.number step)]

pop.mascot : Text
pop.mascot = """
  <svg class="mascot chef-emblem" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="46" fill="#e9d8b6" stroke="#b78a4e" stroke-width="2"/><circle cx="50" cy="50" r="39" fill="none" stroke="#b78a4e" stroke-width="1" stroke-dasharray="2 4"/><path d="M30 55V42C14 39 20 20 34 25C39 12 61 12 66 25C82 20 88 39 71 42V55Z" fill="#fffcf5" stroke="#53644b" stroke-width="2.5"/><path d="M33 47H68M40 29V42M60 29V42" fill="none" stroke="#bac1aa" stroke-width="2"/><rect x="30" y="53" width="41" height="12" rx="3" fill="#fffcf5" stroke="#53644b" stroke-width="2.5"/><path d="M40 75H60" stroke="#b78a4e" stroke-width="2" stroke-linecap="round"/></svg>
  """
pop.header : Text
pop.header = """
  <a class="skip" href="#play">Skip to game</a><input class="pause-input" id="pause" type="checkbox"><div class="page">
  <header class="topbar"><div class="wrap"><a class="brand" href="?" aria-label="Word Pop home"><span class="brand-icon" aria-hidden="true">W</span><span>word<em>pop!</em><small>JUNIOR CHEF CHALLENGE</small></span></a><nav class="toplinks" aria-label="Main navigation"><a href="?view=help">How to play <span aria-hidden="true">↗</span></a><span class="small-pill">✦ Made with a pinch of magic.</span></nav></div></header>
  """

pop.baked : Round -> Nat
pop.baked = cases Round _ _ known _ _ _ _ _ -> List.size known

pop.current : Round -> Nat
pop.current = cases Round _ n _ _ _ _ _ _ -> n

pop.level : Nat -> Nat
pop.level count = Nat.min 4 (Nat.div count 5)

pop.rank : Nat -> Text
pop.rank count = List.at (pop.level count) ["Apprentice Chef", "Mixer Master", "Baker", "Pastry Chef", "Head Chef"] |> Optional.getOrElse "Apprentice Chef"

pop.unlock : Nat -> Text
pop.unlock count =
  if count < 5 then pop.number (5 - count) ++ " more to switch on your mixer"
  else if count < 10 then pop.number (10 - count) ++ " more to fill your cookie jar"
  else if count < 15 then pop.number (15 - count) ++ " more to bake a celebration cake"
  else if count < 20 then pop.number (20 - count) ++ " more to throw a kitchen party"
  else "Your kitchen is ready for the grand feast!"

pop.treat : Nat -> Text
pop.treat i =
  drawing = if Nat.mod i 3 == 0 then "<path d='M13 32H47L42 55H18Z' fill='#e6ad72'/><path d='M22 36L24 50M30 36V50M38 36L36 50' stroke='#c68558' stroke-width='2'/><path d='M10 30Q7 20 19 19Q17 8 29 9Q36 1 41 14Q56 16 50 30Z' fill='#ff88a3' stroke='#e56785' stroke-width='1.5'/><circle cx='29' cy='7' r='4' fill='#e84962'/><path d='M18 24l3 -3M29 18l3 2M41 24l3 -3' stroke='#fff4bf' stroke-width='3' stroke-linecap='round'/>"
    else if Nat.mod i 3 == 1 then "<circle cx='30' cy='30' r='24' fill='#e9ac60' stroke='#cb8740' stroke-width='2'/><circle cx='21' cy='19' r='4' fill='#805144'/><circle cx='39' cy='22' r='3' fill='#805144'/><circle cx='28' cy='36' r='4' fill='#805144'/><circle cx='43' cy='38' r='3' fill='#805144'/><circle cx='17' cy='38' r='2' fill='#805144'/><circle cx='28' cy='10' r='2' fill='#ffe1a8'/><circle cx='36' cy='46' r='2' fill='#ffe1a8'/>"
    else "<ellipse cx='30' cy='37' rx='25' ry='16' fill='#a18ae5'/><rect x='6' y='25' width='48' height='13' rx='6' fill='#fff1cb'/><ellipse cx='30' cy='25' rx='25' ry='16' fill='#bca6f7' stroke='#9880d5' stroke-width='1.5'/><path d='M13 21Q18 15 26 16' fill='none' stroke='#e3d4ff' stroke-width='3' stroke-linecap='round'/>"
  "<svg class='treat-art' viewBox='0 0 60 62' aria-hidden='true'>" ++ drawing ++ "</svg>"

pop.tray : Round -> Boolean -> Nat -> Text
pop.tray round celebrate freshIndex = match round with Round _ _ known _ _ _ _ _ ->
  item i =
    earned = pop.has (pop.number i) known
    classes = "treat-slot" ++ (if earned then " baked" else " locked") ++ (if celebrate && earned && i == freshIndex then " fresh" else "")
    label = "<span class='sr-only'>Word " ++ pop.number (i + 1) ++ (if earned then ", treat baked" else ", not baked yet") ++ "</span>" ++ pop.treat i ++ "<span class='treat-number'>" ++ (if earned then "✓" else pop.number (i + 1)) ++ "</span>"
    pop.link classes (pop.url (pop.withIndex i round)) label
  "<div class='bake-shelf'><div class='shelf-label'><strong>Your fresh-baked collection</strong><span>" ++ pop.number (List.size known) ++ " of 20 treats baked</span></div><nav class='treat-tray' aria-label='Your baked treats'>" ++ Text.join "" (List.map item (List.range 0 20)) ++ "</nav></div>"

pop.kitchen : Nat -> Text
pop.kitchen count =
  "<div class='photo-kitchen' role='img' aria-label='Your kitchen station, level " ++ pop.number (pop.level count + 1) ++ " of 5' style='--scene:" ++ pop.number (pop.level count) ++ "'></div><span class='photo-label'>YOUR STATION <b>LEVEL " ++ pop.number (pop.level count + 1) ++ " / 5</b></span>"
pop.hero : Round -> Boolean -> Nat -> Text
pop.hero round celebrate freshIndex =
  count = pop.baked round
  "<section class='hero culinary-hero level-" ++ pop.number (pop.level count) ++ (if celebrate then " kitchen-celebrating" else "") ++ "' aria-label='Your word kitchen'><div class='kitchen-intro'><div class='eyebrow'><span class='dot'></span> THE JUNIOR CHEF CHALLENGE</div><h1>Step into<br><em>your kitchen.</em></h1><p>Master your spellings. Build your station.<br>Earn your place as head chef.</p><span class='chef-rank'><span aria-hidden='true'>✦</span> " ++ pop.rank count ++ "</span></div><div class='kitchen-window'>" ++ pop.kitchen count ++ "<div class='kitchen-caption'><span class='kitchen-light'></span> " ++ pop.unlock count ++ "</div></div>" ++ pop.tray round celebrate freshIndex ++ "</section>"

pop.tabs : Round -> Text
pop.tabs = cases Round mode n known practice points streak tries step ->
  tab target icon label = pop.link ("mode" ++ (if mode == target then " active" else "")) (pop.url (Round target n known practice points 0 0 0)) ("<span aria-hidden='true'>" ++ icon ++ "</span>" ++ label)
  "<nav class='mode-tabs' aria-label='Game modes'>" ++ tab "flash" "▣" "Flashcards" ++ tab "spell" "✎" "Spell it" ++ tab "mix" "⇄" "Word scramble" ++ "</nav>"

pop.audio : Nat -> Text
pop.audio n = "<div class='audio-row'><span>↗ HEAR THE WORD</span><audio controls preload='none' aria-label='Listen to the word' src='https://raw.githubusercontent.com/wolfbreed1829/word-pop-unison/f84d9aeda078fa1c426d42476f495291d50d6030/assets/audio/" ++ pop.number n ++ ".wav'>Your browser cannot play audio. Use the clue to practice.</audio></div>"

pop.flash : Round -> Text
pop.flash round = match round with Round _ n _ _ _ _ _ _ ->
  card = pop.card n
  word = pop.word card
  marked = Text.replaceAll (pop.focus card) ("<mark>" ++ pop.focus card ++ "</mark>") word
  sentence = Text.replaceAll word ("<strong>" ++ word ++ "</strong>") (pop.sentence card)
  "<div class='flash'><input class='flip-check' id='flip' type='checkbox' aria-label='Flip the flashcard'><div class='flash-inner'><div class='face front'><span class='face-label'>TODAY'S SECRET INGREDIENT</span><span class='face-star' aria-hidden='true'>✦</span><div class='word" ++ (if Text.size word > 7 then " long" else "") ++ "'>" ++ marked ++ "</div><div class='syllable'>" ++ pop.number (Text.size word) ++ " letters · spelling challenge</div></div><div class='face back'><span class='face-label'>LET'S MAKE IT STICK</span><span class='face-star' aria-hidden='true'>✦</span><p class='meaning'>" ++ pop.meaning card ++ "</p><p class='example'>“" ++ sentence ++ "”</p></div></div><label class='flip-label' for='flip'><span aria-hidden='true'>⤾</span> Tap to flip the card</label></div>" ++ pop.audio n ++ "<div class='actions'>" ++ pop.link "btn yellow" (pop.url round ++ "&action=practice") "↻ Practice again" ++ pop.link "btn green" (pop.url round ++ "&action=known") "✓ Got it!" ++ "</div>"

pop.scramble : Text -> Text
pop.scramble word =
  letters = Text.toCharList word |> List.reverse
  "<div class='scramble' aria-label='Scrambled letters'>" ++ Text.join "" (List.map (letter -> "<b>" ++ Text.fromCharList [letter] ++ "</b>") letters) ++ "</div>"

pop.question : Round -> Text -> Text
pop.question round feedback = match round with Round mode n _ _ _ _ _ _ ->
  card = pop.card n
  prompt = if mode == "mix" then pop.scramble (pop.word card) else "<div class='result-icon' aria-hidden='true'>✎</div>"
  title = if mode == "mix" then "Put the letters in their place." else "Listen. Think. Spell!"
  "<div class='question'>" ++ feedback ++ prompt ++ "<h2>" ++ title ++ "</h2><p>" ++ pop.meaning card ++ "</p>" ++ pop.audio n ++ "<form method='get' action=''>" ++ pop.fields round ++ "<label for='answer'>Your spelling</label><div class='answer-row'><input id='answer' name='answer' type='text' placeholder='Type the word…' autocomplete='off' autocapitalize='none' autocorrect='off' inputmode='text' enterkeyhint='done' spellcheck='false' required maxlength='32' aria-describedby='answer-help' autofocus><button class='btn purple' type='submit'>Check it ↗</button></div><p id='answer-help'>" ++ pop.number (Text.size (pop.word card)) ++ " letters. You've got this!</p></form><details class='hint'><summary>☀ Need a little hint?</summary><p>" ++ pop.hint card ++ "<br>It starts with <strong>" ++ Text.take 1 (pop.word card) ++ "</strong>.</p></details></div>"

pop.confetti : Text
pop.confetti = "<div class='confetti' aria-hidden='true'>" ++ Text.join "" (List.map (n -> "<i style='--x:" ++ pop.number (Nat.mod (n * 17) 100) ++ "%;--d:0." ++ pop.number (Nat.mod n 9) ++ "s;--c:" ++ (if Nat.mod n 3 == 0 then "#ffcf4b" else if Nat.mod n 3 == 1 then "#f65d92" else "#77d9bb") ++ "'></i>") (List.range 0 25)) ++ "</div>"

pop.progress : Round -> Text
pop.progress = cases Round _ _ known _ points streak _ _ ->
  "<section class='stats-card' aria-labelledby='progress-title'><div class='panel-heading'><h2 id='progress-title'>Your scorecard</h2><span aria-hidden='true'>✦</span></div><div class='progress-top'><span>Words mastered</span><b>" ++ pop.number (List.size known) ++ " / 20</b></div><div class='progress-bar' role='progressbar' aria-label='Words mastered' aria-valuemin='0' aria-valuemax='20' aria-valuenow='" ++ pop.number (List.size known) ++ "'><div style='width:" ++ pop.number (List.size known * 5) ++ "%'></div></div><div class='stat-row'><div class='stat-box'><b>★ " ++ pop.number points ++ "</b><span>SCORE</span></div><div class='stat-box pink'><b>♨ " ++ pop.number streak ++ "</b><span>STREAK</span></div></div></section>"

pop.bank : Round -> Text
pop.bank = cases Round mode n known practice points _ _ step ->
  chip i =
    card = pop.card i
    mastered = pop.has (pop.number i) known
    classes = "word-chip" ++ (if i == n then " selected" else "") ++ (if mastered then " done" else "")
    label = if mode == "flash" then pop.word card else (if mastered then "✓ " else "") ++ pop.number (i + 1)
    pop.link classes (pop.url (Round mode i known practice points 0 0 step)) label
  "<section class='word-bank'><div class='panel-heading'><h2>Your word collection</h2><span>20 words</span></div><div class='word-grid'>" ++ Text.join "" (List.map chip (List.range 0 20)) ++ "</div><p class='bank-foot'><i></i> Green means you've got it!</p></section>"

pop.sidebar : Round -> Boolean -> Boolean -> Text
pop.sidebar round celebrate retry =
  title = if retry then "Let's try that recipe again." else if celebrate then "Fresh out of the oven!" else "Chef's next challenge"
  message = if retry then "Every great chef experiments. Listen again, then give it a go!" else if celebrate then "A new recipe mastered. Your kitchen is coming together." else pop.unlock (pop.baked round) ++ "."
  pop.progress round ++ "<div class='mascot-card" ++ (if celebrate then " chef-cheering" else "") ++ "'>" ++ pop.mascot ++ "<div><strong>" ++ title ++ "</strong><p>" ++ message ++ "</p></div></div>" ++ pop.badges (pop.baked round) ++ pop.bank round

pop.badges : Nat -> Text
pop.badges count =
  badge threshold symbol name = "<div class='chef-badge" ++ (if count >= threshold then " earned" else "") ++ "'><span aria-hidden='true'>" ++ symbol ++ "</span><strong>" ++ name ++ "</strong><small>" ++ (if count >= threshold then "Unlocked!" else pop.number threshold ++ " words") ++ "</small></div>"
  "<section class='badge-card' aria-label='Chef achievements'><div class='panel-heading'><h2>Your chef's journey</h2><span>4 milestones</span></div><div class='chef-badges'>" ++ badge 5 "✿" "Mixer Master" ++ badge 10 "◉" "Baker" ++ badge 15 "♜" "Pastry Chef" ++ badge 20 "★" "Head chef" ++ "</div></section>"

pop.footer : Text
pop.footer = """
  <footer><span class="mini-brand">BAKED WITH CURIOSITY ✦</span><span>20 words · A kitchen full of possibility</span><label class="pause-label" for="pause">Pause motion</label><a href="https://github.com/wolfbreed1829/word-pop-unison" target="_blank" rel="noopener">Made with Unison ↗</a></footer>
  """

pop.shell : Text -> Text -> Text
pop.shell css body = "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1,viewport-fit=cover'><meta name='theme-color' content='#355a44'><meta name='description' content='Cook up word magic in a colorful kitchen. Every mastered word earns a treat. Flashcards, spelling, and word scrambles, entirely in Unison.'><title>Word Pop! — Junior Chef Challenge</title><link rel='icon' href='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22%3E%3Crect width=%2264%22 height=%2264%22 rx=%2218%22 fill=%22%237350e6%22/%3E%3Ctext x=%2210%22 y=%2248%22 font-size=%2246%22 font-family=%22Arial%22 font-weight=%22bold%22 fill=%22white%22%3EW%3C/text%3E%3C/svg%3E'><style>" ++ css ++ "</style></head><body>" ++ pop.header ++ body ++ "</div></body></html>"

pop.help : Text
pop.help = """
  <main class="help" id="play"><div class="eyebrow">WELCOME TO THE WORD KITCHEN</div><h1>A recipe for little wins.</h1><section><h2>✦ Build your word kitchen</h2><p>Each newly mastered word bakes a cupcake, cookie, or macaron for your tray. Master 5 words to unlock a mixer, 10 for a cookie jar, 15 for a cake, and all 20 for a kitchen party! Your chef badge grows along with your kitchen. Choosing <strong>Got it!</strong> on a flashcard also adds a treat and earns 5 points. Each word adds one treat per round, so retries and repeated answers never double-count.</p></section><section><h2>▣ Flip a flashcard</h2><p>Read the word out loud, play its recording, and tap the flip button to see what it means. Choose <strong>Got it!</strong> to mark it mastered, or <strong>Practice again</strong> to put it on your practice list.</p></section><section><h2>✎ Give spelling a go</h2><p>Choose <strong>Spell it</strong>, play the word, and type what you hear. A correct first try earns 10 points. A correct answer after another try earns 5. A mistake resets your streak, but you can always try again. Each word earns points once per round.</p></section><section><h2>⇄ Untangle a word</h2><p>Choose <strong>Word scramble</strong> and use all the colorful letters to figure out the word. The meaning, recording, and hint can help. Your progress travels with the game links in this tab. Start a fresh round from the home logo; no account is needed.</p></section><section><h2>☀ Make yourself comfortable</h2><p>Everything works with a keyboard: Tab to a control, then Enter or Space. Use your browser zoom for bigger letters. The site follows your reduced-motion setting, and the footer has a pause-motion toggle. Audio only plays when you press play.</p></section><a class="btn purple" href="?">Let's play ↗</a></main>
  """

pop.next : Round -> Round
pop.next = cases Round mode n known practice points streak _ step ->
  Round mode (Nat.mod (n + 1) 20) known practice points streak 0 (step + 1)

pop.withIndex : Nat -> Round -> Round
pop.withIndex i = cases Round mode _ known practice points streak _ step -> Round mode i known practice points streak 0 step

pop.practiceAgain : Round -> Round
pop.practiceAgain = cases Round mode n known practice points _ _ step ->
  Round mode n known (pop.add (pop.number n) practice) points 0 1 step

pop.master : Boolean -> Round -> Round
pop.master scored = cases Round mode n known practice points streak tries step ->
  key = pop.number n
  fresh = not (pop.has key known)
  earned = if fresh then (if scored then pop.points tries else 5) else 0
  Round mode n (pop.add key known) (List.filter (x -> not (x == key)) practice) (points + earned) (if scored && fresh then streak + 1 else streak) tries step

pop.bottom : Round -> Text
pop.bottom round = match round with Round _ n known _ _ _ _ _ ->
  dots = Text.join "" (List.map (i -> "<i class='" ++ (if i == n then "current" else if pop.has (pop.number i) known then "done" else "") ++ "'></i>") (List.range 0 20))
  "<div class='card-foot'><span>One word at a time. ✨</span><div class='progress-dots' aria-hidden='true'>" ++ dots ++ "</div><div class='round-nav'>" ++ pop.link "circle-btn" (pop.url (pop.withIndex (Nat.mod (n + 19) 20) round)) "<span aria-label='Previous word'>←</span>" ++ pop.link "circle-btn" (pop.url (pop.withIndex (Nat.mod (n + 1) 20) round)) "<span aria-label='Next word'>→</span>" ++ "</div></div>"

pop.finished : Round -> Text
pop.finished = cases Round mode _ known practice points _ _ _ ->
  restart = Round mode 0 [] [] 0 0 0 0
  practiceIndex = List.head practice |> Optional.flatMap Nat.fromText |> Optional.getOrElse 0
  practiceLink = if List.size practice > 0 then pop.link "btn yellow" (pop.url (Round mode practiceIndex known practice points 0 0 0)) "Revisit a tricky word ↗" else ""
  "<div class='finished'>" ++ pop.confetti ++ pop.mascot ++ "<h2>Your batch is ready!</h2><p>You completed your spelling challenge.<br>Every word is another ingredient for success.</p><div class='score-big'>" ++ pop.number points ++ "<span style='font-size:25px'> ★</span></div><p>" ++ pop.number (List.size known) ++ " words mastered · " ++ pop.number (List.size practice) ++ " to practice</p><div class='actions'>" ++ practiceLink ++ pop.link "btn purple" (pop.url restart) "Play a fresh round ↗" ++ "</div></div>"

pop.content : Round -> Text -> Text -> Text
pop.content round answer action = match round with Round mode n known practice points streak tries step ->
  if step >= 20 then pop.finished round
  else if mode == "flash" then pop.flash round
  else if answer == "" then pop.question round ""
  else if pop.correct (pop.card n) answer then
    earned = if pop.has (pop.number n) known then 0 else pop.points tries
    mastered = pop.master true round
    "<div class='question'>" ++ pop.confetti ++ "<div class='result-icon' aria-hidden='true'>🌟</div><div class='feedback'><h2>That's the word!</h2><p>+" ++ pop.number earned ++ " points. Your practice is paying off.</p></div><div class='success-word'>" ++ pop.word (pop.card n) ++ "</div><p>" ++ pop.sentence (pop.card n) ++ "</p>" ++ pop.link "btn purple" (pop.url (pop.next mastered)) (if step == 19 then "See my round ↗" else "Next word →") ++ "</div>"
  else pop.question (pop.practiceAgain round) "<div class='feedback retry' role='status'><h2>Almost! Give it another go.</h2><p>Listen again and take your time. Mistakes help us learn.</p></div>"

pop.page : Text -> Round -> Text -> Text -> Text
pop.page css initial answer action =
  afterAction = if action == "known" then pop.next (pop.master false initial) else if action == "practice" then pop.next (pop.practiceAgain initial) else initial
  match afterAction with Round mode n _ _ _ _ _ step ->
    displayRound = if answer == "" || mode == "flash" then afterAction else if pop.correct (pop.card n) answer then pop.master true afterAction else pop.practiceAgain afterAction
    freshTreat = pop.baked displayRound > pop.baked initial
    retry = not (answer == "") && not (mode == "flash") && not (pop.correct (pop.card n) answer)
    stageTitle = if mode == "flash" then "TODAY'S RECIPE: A LITTLE PRACTICE." else if mode == "spell" then "READY, SET, BAKE A WORD!" else "MIX UP A LITTLE LETTER MAGIC."
    tip = if mode == "flash" then "Say it. Cover it. Spell it!" else if mode == "spell" then "Listen for the little sounds." else "Look for letters that like to stick together."
    tipBody = if mode == "flash" then "Say the word out loud, flip the card, then try spelling it from memory." else if mode == "spell" then "Play the word again. Break it into sounds. Put those sounds back together." else "Try finding ar, or, and ore. These letter teams can help you find the word."
    shuffle = pop.withIndex (Nat.mod (n + 7) 20) afterAction
    body = "<main class='wrap kitchen-page" ++ (if freshTreat then " new-treat" else "") ++ "' id='play' data-baked='" ++ pop.number (pop.baked displayRound) ++ "'>" ++ pop.hero displayRound freshTreat (pop.current initial) ++ "<div class='layout'><section class='play-area' aria-label='Spelling game'>" ++ pop.tabs displayRound ++ (if freshTreat then "<div class='bake-toast' role='status'><span aria-hidden='true'>✦</span> A fresh treat just landed in your kitchen! <strong>" ++ pop.number (pop.baked displayRound) ++ " / 20 baked</strong></div>" else "") ++ "<div class='card-stage'><div class='stage-top'><span>" ++ stageTitle ++ "</span><b>" ++ pop.number (Nat.min 20 (step + 1)) ++ " / 20</b></div>" ++ pop.content afterAction answer action ++ "</div>" ++ pop.bottom displayRound ++ "<div class='tip'><div class='tip-icon' aria-hidden='true'>☀</div><div><strong>" ++ tip ++ "</strong><p>" ++ tipBody ++ "</p></div></div><div class='motivation'>" ++ pop.link "shuffle" (pop.url shuffle) "⇄ Surprise me with another word" ++ "</div></section><aside class='sidebar' aria-label='Your progress and words'>" ++ pop.sidebar displayRound freshTreat retry ++ "</aside></div>" ++ pop.footer ++ "</main>"
    pop.shell css body

pop.param : Text -> HttpRequest -> Text
pop.param key request =
  query =
    lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpRequest.uri request
      |> lib.unison_base_7_20_0.IO.net.URI.query
      |> lib.unison_base_7_20_0.IO.net.URI.Query.fromRawQuery
      |> Optional.getOrElse lib.unison_base_7_20_0.IO.net.URI.Query.empty
  lib.unison_base_7_20_0.IO.net.URI.Query.getParam key query |> List.head |> Optional.getOrElse ""

pop.natParam : Text -> HttpRequest -> Nat
pop.natParam key request = pop.param key request |> Nat.fromText |> Optional.getOrElse 0

pop.indexes : Text -> [Text]
pop.indexes value =
  values = Text.splitOnText "," (Text.take 100 value)
  List.filter (x -> pop.has x values) (List.map pop.number (List.range 0 20))

pop.round : HttpRequest -> Round
pop.round request =
  mode = pop.param "m" request
  Round (if mode == "spell" || mode == "mix" then mode else "flash")
    (Nat.mod (pop.natParam "n" request) 20)
    (pop.indexes (pop.param "k" request))
    (pop.indexes (pop.param "p" request))
    (Nat.min 200 (pop.natParam "s" request))
    (Nat.min 20 (pop.natParam "r" request))
    (Nat.min 1 (pop.natParam "t" request))
    (Nat.min 20 (pop.natParam "step" request))

pop.response : Text -> Bytes -> HttpResponse
pop.response kind bytes =
  lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.ok (lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.Body.Body bytes)
    |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Content-Type" kind
    |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "X-Content-Type-Options" "nosniff"

pop.service : Text -> [Bytes] -> HttpRequest -> HttpResponse
pop.service css clips request =
  if pop.param "audio" request == "" then
    page = if pop.param "view" request == "help" then pop.shell css pop.help else pop.page css (pop.round request) (Text.take 32 (pop.param "answer" request)) (pop.param "action" request)
    pop.response "text/html; charset=utf-8" (Text.toUtf8 page)
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Cache-Control" "no-store"
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Content-Security-Policy" "default-src 'none'; script-src 'none'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; media-src 'self' https://raw.githubusercontent.com; img-src data: https://raw.githubusercontent.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Referrer-Policy" "no-referrer"
  else match List.at (pop.natParam "audio" request) clips with
    Some clip -> pop.response "audio/wav" clip |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.addHeader "Cache-Control" "public, max-age=86400"
    None -> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.HttpResponse.notFound

pop.assets : '{IO, Exception} (Text, [Bytes])
pop.assets = do
  css = lib.unison_base_7_20_0.IO.FilePath.readFileUtf8 (FilePath "assets/style.css")
  kitchenCss = lib.unison_base_7_20_0.IO.FilePath.readFileUtf8 (FilePath "assets/kitchen.css")
  clips = List.map (n -> lib.unison_base_7_20_0.IO.FilePath.readFile (FilePath ("assets/audio/" ++ pop.number n ++ ".wav"))) (List.range 0 20)
  studioCss = lib.unison_base_7_20_0.IO.FilePath.readFileUtf8 (FilePath "assets/studio.css")
  (css ++ kitchenCss ++ studioCss, clips)

pop.local : '{IO, Exception} ()
pop.local = do
  (css, clips) = pop.assets()
  config =
    lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.server.Config.default
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.server.Config.port.set (Port "8089")
      |> lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.server.Config.hostName.set (Some (HostName "127.0.0.1"))
  printLine "Word Pop! http://127.0.0.1:8089"
  Threads.run do
    lib.unison_cloud_27_3_1.lib.unison_http_15_0_0.server.runServer config (request -> Left (pop.service css clips request))

pop.deploy : '{IO, Exception} ()
pop.deploy = do
  (css, _) = pop.assets()
  url = lib.unison_cloud_27_3_1.Cloud.main do
    -- This handler is pure. Deploy it directly without the pooled ability wrapper,
    -- so rendering a page does not require selecting another worker location.
    -- Audio is served from an immutable public GitHub commit, so the 1.5 MB
    -- recording collection is not captured in every game request's closure.
    hash = lib.unison_cloud_27_3_1.Cloud.deploy.remote (lib.unison_cloud_27_3_1.Environment.default()) (pop.service css [])
    _ = lib.unison_cloud_27_3_1.Cloud.exposeHttp hash
    lib.unison_cloud_27_3_1.ServiceName.assign (lib.unison_cloud_27_3_1.ServiceName.named "word-pop") hash
  printLine (lib.unison_base_7_20_0.IO.net.URI.toText (url()))

test> pop.tests.deck = check (List.size pop.deck == 20 && pop.word (pop.card 19) == "guard")
test> pop.tests.answers = check (pop.correct (pop.card 0) " SMART " && not (pop.correct (pop.card 0) "smrt") && not (pop.correct (pop.card 0) ""))
test> pop.tests.points = check (pop.points 0 == 10 && pop.points 1 == 5)
test> pop.tests.master =
  initial = Round "spell" 0 [] [] 0 0 0 0
  once = pop.master true initial
  twice = pop.master true once
  check (pop.url once == pop.url twice && pop.url once == "?m=spell&n=0&k=0&p=&s=10&r=1&t=0&step=0")
test> pop.tests.retry = check (pop.url (pop.master true (pop.practiceAgain (Round "spell" 0 [] [] 0 4 0 0))) == "?m=spell&n=0&k=0&p=&s=5&r=1&t=1&step=0")
test> pop.tests.indexes = check (Text.join "," (pop.indexes "3,3,99,<script>,1") == "1,3")
test> pop.tests.escape = check (pop.escape "<script>" == "&lt;script&gt;")
test> pop.tests.kitchenLevels = check (pop.level 0 == 0 && pop.level 4 == 0 && pop.level 5 == 1 && pop.level 10 == 2 && pop.level 15 == 3 && pop.level 20 == 4)
test> pop.tests.kitchenRewards =
  initial = Round "spell" 0 [] [] 0 0 0 0
  earned = pop.master true initial
  check (pop.baked (pop.practiceAgain initial) == 0 && pop.baked earned == 1 && pop.baked (pop.master true earned) == 1 && pop.baked (pop.next earned) == 1)
